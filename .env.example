# ===========================
# Martin's Algorithm — .env
# ===========================

# CoinMarketCap Pro API Key
# Get yours at: https://pro.coinmarketcap.com/
CMC_API_KEY=your_cmc_api_key_here

# Etherscan API Key (for Ethereum on-chain data)
# Get yours at: https://etherscan.io/apis
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# BscScan API Key (for BNB Chain on-chain data)
# Get yours at: https://bscscan.com/apis
BSCSCAN_API_KEY=your_bscscan_api_key_here

# GitHub API Token (for developer activity scoring)
# Get yours at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# Environment: development | production
MARTIN_ENV=development

# Maximum auto-scan interval (seconds)
MARTIN_SCAN_INTERVAL=3600

# Maximum value for any auto-proposed transaction (0 = alerts only, no tx)
MARTIN_MAX_TRANSACTION_VALUE=0

# Always require user approval for any action
MARTIN_REQUIRE_USER_APPROVAL=true

# API server settings
MARTIN_API_HOST=0.0.0.0
MARTIN_API_PORT=8000
